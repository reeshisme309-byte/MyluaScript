-- ============================================================================
-- 5. PLAYBACK CONTROLLER
-- ============================================================================
local State = {
    CurrentSong = Songs[1],
    Events = Songs[1]._events,
    IsPlaying = false,
    IsPaused = false,
    Loop = false,
    BPM = Songs[1].bpm,
    Transpose = 0,
    Index = 1,
    Elapsed = 0,
    Total = Songs[1]._duration,
    Token = 0,
    LastNote = "Ready"
}

local UI = {
    RefreshPlayer = function() end,
    Notify = function(title, content)
        pcall(function()
            Fluent:Notify({
                Title = title,
                Content = content,
                Duration = 3
            })
        end)
    end
}

local function StopSong(silent)
    State.Token += 1
    State.IsPlaying = false
    State.IsPaused = false
    State.Index = 1
    State.Elapsed = 0
    State.LastNote = "Stopped"
    UI.RefreshPlayer()
    if not silent then
        UI.Notify("Auto Piano", "Playback stopped.")
    end
end

local function StartSong(song)
    if not song then return end
    local evs = song._events
    if not evs or #evs == 0 then
        local parsed, errs = ParseSheet(song.sheet)
        if #errs > 0 then
            UI.Notify("Sheet Error", errs[1])
            return
        end
        evs = parsed
        song._events = parsed
    end

    StopSong(true)
    State.CurrentSong = song
    State.Events = evs
    State.BPM = song.bpm or 120
    State.Total = EstimateSeconds(evs, State.BPM)
    State.Elapsed = 0
    State.Index = 1
    State.IsPlaying = true
    State.IsPaused = false
    State.Token += 1

    local activeToken = State.Token
    UI.RefreshPlayer()
    UI.Notify("Now Playing", song.title .. " (" .. State.BPM .. " BPM)")

    task.spawn(function()
        while State.IsPlaying and State.Token == activeToken do
            if State.IsPaused then
                task.wait(0.05)
                continue
            end

            if State.Index > #State.Events then
                if State.Loop then
                    State.Index = 1
                    State.Elapsed = 0
                else
                    StopSong(true)
                    State.LastNote = "Completed"
                    UI.RefreshPlayer()
                    return
                end
            end

            local ev = State.Events[State.Index]
            if ev then
                local labels = {}
                for _, ch in ipairs(ev.notes) do
                    local tr = TransposeChar(ch, State.Transpose)
                    local idx = CHAR_TO_INDEX[tr]
                    if idx then
                        table.insert(labels, IndexToNoteName(idx))
                    end
                    TriggerNote(ch, State.Transpose)
                end
                if #labels > 0 then
                    State.LastNote = table.concat(labels, " + ")
                end

                local waitTime = math.max(ev.beats * (60 / math.max(State.BPM, 20)), 0.025)
                State.Index += 1
                UI.RefreshPlayer()

                local waited = 0
                while waited < waitTime do
                    if not State.IsPlaying or State.Token ~= activeToken then return end
                    if State.IsPaused then
                        task.wait(0.05)
                    else
                        local dt = task.wait(math.min(0.03, waitTime - waited))
                        waited += dt
                        State.Elapsed = math.min(State.Total, State.Elapsed + dt)
                        UI.RefreshPlayer()
                    end
                end
            else
                State.Index += 1
            end
        end
    end)
end

