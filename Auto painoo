local function ToggleGuiVisibility()
    SetGuiOpen(not GuiOpen)
    ToggleBtn.Text = GuiOpen and "🎹 GUI: OPEN" or "🎹 GUI: CLOSED"
    btnStroke.Color = GuiOpen and Color3.fromRGB(114, 92, 246) or Color3.fromRGB(239, 68, 68)
end

ToggleBtn.MouseButton1Click:Connect(ToggleGuiVisibility)

local keyConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == ToggleKey then
        ToggleGuiVisibility()
    end
end)

getgenv().AutoPianoModdedCleanup = function()
    StopSong(true)
    if keyConn then keyConn:Disconnect() end
    if ToggleGui then ToggleGui:Destroy() end
    pcall(function()
        if Window and Window.Destroy then
            Window:Destroy()
        end
    end)
    for _, sg in ipairs(GetFluentModdedGuis()) do
        pcall(function() sg:Destroy() end)
    end
end

