local GuiOpen = true
local ToggleKey = Enum.KeyCode.RightControl

local function GetFluentModdedGuis()
    local list = {}
    for _, obj in ipairs(GetGuiRoot():GetChildren()) do
        if obj:IsA("ScreenGui") and not ExistingGuis[obj] and obj.Name ~= "FluentModdedToggleGui" then
            table.insert(list, obj)
        end
    end
    return list
end

local function SetGuiOpen(open)
    GuiOpen = open
    for _, sg in ipairs(GetFluentModdedGuis()) do
        sg.Enabled = GuiOpen
    end
    pcall(function()
        if Window and Window.Root then
            Window.Root.Visible = GuiOpen
        end
    end)
end

