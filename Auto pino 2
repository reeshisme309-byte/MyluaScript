-- 61-key Roblox sheet characters mapped to MIDI numbers (C2=36 .. C7=96)
local SHEET_TO_MIDI = {
    ["1"] = 36, ["!"] = 37, ["2"] = 38, ["@"] = 39, ["3"] = 40, ["4"] = 41, ["$"] = 42,
    ["5"] = 43, ["%"] = 44, ["6"] = 45, ["^"] = 46, ["7"] = 47, ["8"] = 48, ["*"] = 49,
    ["9"] = 50, ["("] = 51, ["0"] = 52, ["q"] = 53, ["Q"] = 54, ["w"] = 55, ["W"] = 56,
    ["e"] = 57, ["E"] = 58, ["r"] = 59, ["t"] = 60, ["T"] = 61, ["y"] = 62, ["Y"] = 63,
    ["u"] = 64, ["i"] = 65, ["I"] = 66, ["o"] = 67, ["O"] = 68, ["p"] = 69, ["P"] = 70,
    ["a"] = 71, ["s"] = 72, ["S"] = 73, ["d"] = 74, ["D"] = 75, ["f"] = 76, ["g"] = 77,
    ["G"] = 78, ["h"] = 79, ["H"] = 80, ["j"] = 81, ["J"] = 82, ["k"] = 83, ["l"] = 84,
    ["L"] = 85, ["z"] = 86, ["Z"] = 87, ["x"] = 88, ["c"] = 89, ["C"] = 90, ["v"] = 91,
    ["V"] = 92, ["b"] = 93, ["B"] = 94, ["n"] = 95, ["m"] = 96
}

local NOTE_NAMES = {"C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"}
local function MidiToName(midi)
    local octave = _math.floor(midi / 12) - 1
    return NOTE_NAMES[(midi % 12) + 1] .. tostring(octave)
end

-- ============================================================================
-- 4. PLAYBACK ENGINE STATE & CONTROLS (COPIED & ADAPTED FROM SOURCE)
-- ============================================================================
local events = {}
local sustain = false
local key88_enabled = true
local auto_sustain_enabled = true
local no_note_off_enabled = false
local random_note_enabled = false
local deblack_enabled = false
local deblack_level = 65
local deblack_strict = true
local loop_enabled = false
local transpose_semitones = 0

local shift = false
local ctrl = false
local active_notes = {}
local start_time = 0
local next_event_index = 1
local paused = true
local pause_position = 0
local total_duration = 0
local playback_speed = 1.0
local song_loaded = false
local current_song_title = "None"
local last_played_note = "Ready"

local function send_key(down, kc)
    if not vim or not kc then return end
    _pcall(function()
        vim:SendKeyEvent(down, kc, false, game)
    end)
end

local function release_all_keys()
    for noteNum, k in pairs(active_notes) do
        if k and k.keycode then
            send_key(false, k.keycode)
        end
        active_notes[noteNum] = nil
    end
    if ctrl then
        send_key(false, Enum.KeyCode.LeftControl)
        ctrl = false
    end
    if shift then
        send_key(false, Enum.KeyCode.LeftShift)
        shift = false
    end
    if sustain then
        send_key(false, Enum.KeyCode.Space)
        sustain = false
    end
end

local function get_current_playback_position()
    if paused then
        return pause_position
    end
    return _math.max(0, (os.clock() - start_time) * playback_speed)
end

local function apply_deblack(parsed_events)
    if not deblack_enabled then
        return parsed_events
    end

    local note_on_times = {}
    local last_note_off = {}
    local keep_indexes = {}
    local n = #parsed_events

    for i = 1, n do
        local note = parsed_events[i]
        if not note.abs_time or type(note.abs_time) ~= "number" or note.type == "control" or not note.channel or not note.note then
            keep_indexes[i] = true
        else
            local key = tostring(note.channel) .. ":" .. tostring(note.note)
            if note.vel and note.vel > 0 then
                local should_ignore = false
                if deblack_strict then
                    local prev_off = last_note_off[key]
                    if prev_off and prev_off.t and prev_off.v then
                        local dt = note.abs_time - prev_off.t
                        local vel_diff = _math.abs(note.vel - prev_off.v)
                        if dt < 0.035 and vel_diff < 7 then
                            should_ignore = true
                        end
                    end
                end
                if not should_ignore then
                    note_on_times[key] = { t = note.abs_time, idx = i, v = note.vel }
                end
            else
                local on_data = note_on_times[key]
                if on_data and on_data.t and on_data.v then
                    local dt_ms = (note.abs_time - on_data.t) * 1000
                    local vel = on_data.v
                    last_note_off[key] = { t = note.abs_time, v = vel }
                    note_on_times[key] = nil
                    if not (vel <= deblack_level and dt_ms < 20) then
                        keep_indexes[on_data.idx] = true
                        keep_indexes[i] = true
                    end
                else
                    keep_indexes[i] = true
                end
            end
        end
    end

    local filtered = {}
    for i = 1, n do
        if keep_indexes[i] then
            filtered[#filtered + 1] = parsed_events[i]
        end
    end
    return filtered
end

local function stop_playback()
    paused = true
    start_time = 0
    next_event_index = 1
    pause_position = 0
    release_all_keys()
end

local function pause_playback()
    if not paused then
        pause_position = get_current_playback_position()
        paused = true
        release_all_keys()
    end
end

local function resume_playback()
    if paused and song_loaded and #events > 0 then
        start_time = os.clock() - (pause_position / _math.max(playback_speed, 0.05))
        paused = false
    end
end

local function start_playback(parsed_events, title)
    stop_playback()
    events = apply_deblack(parsed_events)
    current_song_title = title or "Custom Sheet"
    total_duration = events[#events] and events[#events].abs_time or 0
    pause_position = 0
    next_event_index = 1
    start_time = os.clock()
    paused = false
    song_loaded = #events > 0
end

local function play_realtime_events()
    if paused or not song_loaded then return end
    local elapsed = get_current_playback_position()

    while next_event_index <= #events do
        local ev = events[next_event_index]
        local event_time = ev.abs_time

        if random_note_enabled then
            if ev.type == "off" then
                event_time = _math.max(0, ev.abs_time - (_math.random(0, 15) * 0.01))
            elseif ev.type == "on" then
                event_time = _math.max(0, ev.abs_time - (_math.random(0, 5) * 0.01))
            end
        end

        if event_time <= elapsed then
            if ev.type == "on" then
                local transposedNote = _math.clamp(ev.note + transpose_semitones, 21, 108)
                local k = key_map[transposedNote]
                if k then
                    if not key88_enabled and k.ctrl then
                        next_event_index += 1
                        continue
                    end
                    if k.ctrl and not ctrl then send_key(true, Enum.KeyCode.LeftControl); ctrl = true
                    elseif not k.ctrl and ctrl then send_key(false, Enum.KeyCode.LeftControl); ctrl = false end

                    if k.shift and not shift then send_key(true, Enum.KeyCode.LeftShift); shift = true
                    elseif not k.shift and shift then send_key(false, Enum.KeyCode.LeftShift); shift = false end

                    send_key(true, k.keycode)
                    active_notes[ev.note] = k
                    last_played_note = MidiToName(transposedNote)

                    if no_note_off_enabled then
                        send_key(false, k.keycode)
                        active_notes[ev.note] = nil
                    end
                end
            elseif ev.type == "off" then
                if not no_note_off_enabled then
                    local k = active_notes[ev.note]
                    if k then
                        send_key(false, k.keycode)
                        active_notes[ev.note] = nil
                    end
                end
            elseif ev.type == "control" then
                local s = (ev.vel or 127) >= 64
                if auto_sustain_enabled then
                    if s ~= sustain then
                        send_key(s, Enum.KeyCode.Space)
                        sustain = s
                    end
                elseif not sustain then
                    send_key(true, Enum.KeyCode.Space)
                    sustain = true
                end
            end
            next_event_index += 1
        else
            break
        end
    end

    if next_event_index > #events then
        if loop_enabled and #events > 0 then
            release_all_keys()
            next_event_index = 1
            pause_position = 0
            start_time = os.clock()
        else
            stop_playback()
            last_played_note = "Finished"
        end
    end
end

-- ============================================================================
-- 5. SHEET PARSER (CONVERTS SHEETS INTO TIMED NOTE-ON / NOTE-OFF EVENTS)
-- ============================================================================
local function sheet_to_events(rawSheet, bpm)
    local parsed = {}
    local errors = {}
    if type(rawSheet) ~= "string" or rawSheet:match("^%s*$") then
        return parsed, {"Sheet is empty."}
    end

    local secPerBeat = 60 / _math.clamp(tonumber(bpm) or 120, 30, 320)
    local cursorSec = 0
    local noteSeq = 0
    local i, len = 1, #rawSheet

    local function pushNote(ch, startSec, durSec)
        local midi = SHEET_TO_MIDI[ch]
        if not midi then return false end
        noteSeq += 1
        parsed[#parsed + 1] = {
            type = "on",
            note = midi,
            vel = 95,
            channel = (noteSeq % 4) + 1,
            abs_time = startSec
        }
        parsed[#parsed + 1] = {
            type = "off",
            note = midi,
            vel = 0,
            channel = (noteSeq % 4) + 1,
            abs_time = startSec + _math.max(durSec, 0.04)
        }
        return true
    end

    while i <= len do
        local ch = rawSheet:sub(i, i)
        if ch == "[" then
            local closePos = rawSheet:find("]", i + 1, true)
            if not closePos then
                table.insert(errors, "Unclosed '[' bracket at char " .. i)
                break
            end
            local inside = rawSheet:sub(i + 1, closePos - 1)
            local added = false
            for j = 1, #inside do
                if pushNote(inside:sub(j, j), cursorSec, secPerBeat * 0.85) then
                    added = true
                end
            end
            if added then cursorSec += secPerBeat end
            i = closePos + 1
        elseif ch == "{" then
            local closePos = rawSheet:find("}", i + 1, true)
            if not closePos then
                table.insert(errors, "Unclosed '{' brace at char " .. i)
                break
            end
            local inside = rawSheet:sub(i + 1, closePos - 1)
            local notes = {}
            for j = 1, #inside do
                local c = inside:sub(j, j)
                if SHEET_TO_MIDI[c] then notes[#notes + 1] = c end
            end
            local step = (#notes > 0) and (secPerBeat / #notes) or (secPerBeat * 0.25)
            for _, n in ipairs(notes) do
                pushNote(n, cursorSec, step * 0.85)
                cursorSec += step
            end
            i = closePos + 1
        elseif SHEET_TO_MIDI[ch] then
            pushNote(ch, cursorSec, secPerBeat * 0.85)
            cursorSec += secPerBeat
            i += 1
        elseif ch == " " then
            cursorSec += secPerBeat * 0.45
            i += 1
        elseif ch == "-" or ch == "|" then
            cursorSec += secPerBeat * 0.85
            i += 1
        elseif ch == "\n" or ch == "\r" or ch == "/" then
            cursorSec += secPerBeat * 1.0
            i += 1
        else
            i += 1
        end
    end

    if #parsed == 0 then
        table.insert(errors, "No valid piano notes found.")
    end

    table.sort(parsed, function(a, b)
        if a.abs_time == b.abs_time then
            return a.type == "off" and b.type == "on"
        end
        return a.abs_time < b.abs_time
    end)

    return parsed, errors
end

