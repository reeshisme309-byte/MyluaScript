    Default = tostring(customBpm),
    Numeric = true,
    Callback = function(v) customBpm = tonumber(v) or 120 end
})

Tabs.Editor:AddInput("CustomSheetInp", {
    Title = "Piano Sheet Notes",
    Default = customSheetText,
    Callback = function(v) customSheetText = v end
})

Tabs.Editor:AddButton({
    Title = "Parse & Play Custom Sheet",
    Callback = function()
        local evs, errs = sheet_to_events(customSheetText, customBpm)
        if #errs > 0 then
            StatusPara:SetDesc("❌ " .. errs[1])
            return
        end
        start_playback(evs, customTitle)
        StatusPara:SetDesc("▶️ Playing Custom Sheet: " .. customTitle)
    end
})

Tabs.Editor:AddInput("RemoteSongUrlInp", {
    Title = "Remote Sheet / JSON URL",
    Placeholder = "https://... (raw sheet text or JSON {title,bpm,sheet})",
    Callback = function(v) urlOrJsonInput = v end
})

Tabs.Editor:AddButton({
    Title = "Fetch & Play URL",
    Callback = function()
        if urlOrJsonInput == "" then
            StatusPara:SetDesc("❌ Enter a URL first.")
            return
        end
        StatusPara:SetDesc("⏳ Fetching URL...")
        _task.spawn(function()
            local ok, body = _pcall(function() return game:HttpGet(urlOrJsonInput) end)
            if not ok or type(body) ~= "string" then
                StatusPara:SetDesc("❌ Failed to fetch URL.")
                return
            end
            local title = "Remote Song"
            local bpm = 120
            local sheet = body
            local decodedOk, decoded = _pcall(function() return http_service:JSONDecode(body) end)
            if decodedOk and type(decoded) == "table" and decoded.sheet then
                title = decoded.title or title
                bpm = tonumber(decoded.bpm) or bpm
                sheet = decoded.sheet
            end
            local evs, errs = sheet_to_events(sheet, bpm)
            if #errs > 0 then
                StatusPara:SetDesc("❌ " .. errs[1])
                return
            end
            start_playback(evs, title)
            StatusPara:SetDesc("▶️ Playing Remote: " .. title)
        end)
    end
})

