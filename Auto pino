-- ════════════════════════════════════════════════════════
--  §4  NOTE NAME → MIDI NUMBER
--      "C4" → 60   "Bb3" → 58   "F#5" → 78
-- ════════════════════════════════════════════════════════

local NOTE_SEMI = {C=0,D=2,E=4,F=5,G=7,A=9,B=11}

local function noteToMidi(str)
    -- Accepts: C4  Db4  D#4  Bb3  F#5  etc.
    local letter, acc, oct = str:match("^([A-Ga-g])([b#]?)(%d+)$")
    if not letter then return nil end
    letter = letter:upper()
    local semi = NOTE_SEMI[letter]
    if not semi then return nil end
    if acc == "b" then semi = semi - 1
    elseif acc == "#" then semi = semi + 1 end
    return (tonumber(oct) + 1) * 12 + semi
end

-- Pre-build a name→midi table for every note string used in songs
local NOTE_CACHE = {}
local function midi(note)
    if NOTE_CACHE[note] then return NOTE_CACHE[note] end
    -- Also handle flat-name style: "Db4" → D=2 -1 = 1, oct4 → 61
    local n = noteToMidi(note)
    NOTE_CACHE[note] = n
    return n
end

-- ════════════════════════════════════════════════════════
--  §5  KEYBOARD ENGINE  (VirtualInputManager)
-- ════════════════════════════════════════════════════════

local shiftHeld = false
local ctrlHeld  = false

local function setMod(key, held, wantHeld)
    if wantHeld == held then return held end
    VIM:SendKeyEvent(wantHeld, key, false, game)
    return wantHeld
end

local function ReleaseAll()
    if shiftHeld then VIM:SendKeyEvent(false, Enum.KeyCode.LeftShift,   false, game) shiftHeld=false end
    if ctrlHeld  then VIM:SendKeyEvent(false, Enum.KeyCode.LeftControl, false, game) ctrlHeld=false  end
end

-- Press a note by MIDI number. Presses + immediately releases.
local function PressNote(midiNum, transpose)
    local n = midiNum + (transpose or 0)
    local k = KM[n]
    if not k then return end

    -- Update modifier state
    shiftHeld = setMod(Enum.KeyCode.LeftShift,   shiftHeld, k.shift == true)
    ctrlHeld  = setMod(Enum.KeyCode.LeftControl, ctrlHeld,  k.ctrl  == true)

    -- Fire the note key
    VIM:SendKeyEvent(true,  k.keycode, false, game)
    VIM:SendKeyEvent(false, k.keycode, false, game)
end

-- Press a note by name string ("C4", "Bb3", etc.)
local function PressNoteByName(name, transpose)
    local m = midi(name)
    if not m then return end
    PressNote(m, transpose or 0)
end

