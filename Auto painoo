-- ============================================================================
-- 3. 61-KEY PIANO MAPPING, TRANSPOSITION & SHEET PARSER
-- ============================================================================
local SCALE_CHARS = "1!2@34$5%6^78*9(0qQwWeErtTyYuiIoOpPasSdDfgGhHjJklLzZxcCvVbBnm"
local CHAR_TO_INDEX = {}
local INDEX_TO_CHAR = {}
local NOTE_NAMES = {"C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"}

for i = 1, #SCALE_CHARS do
    local ch = SCALE_CHARS:sub(i, i)
    CHAR_TO_INDEX[ch] = i
    INDEX_TO_CHAR[i] = ch
end

local function IndexToNoteName(idx)
    if idx == 61 then return "C7" end
    local octave = math.floor((idx - 1) / 12) + 2
    local semitone = ((idx - 1) % 12) + 1
    return NOTE_NAMES[semitone] .. tostring(octave)
end

local SHIFT_MAP = {
    ["!"] = Enum.KeyCode.One,   ["@"] = Enum.KeyCode.Two,
    ["$"] = Enum.KeyCode.Four,  ["%"] = Enum.KeyCode.Five,
    ["^"] = Enum.KeyCode.Six,   ["*"] = Enum.KeyCode.Eight,
    ["("] = Enum.KeyCode.Nine,
}

local NUM_MAP = {
    ["1"] = Enum.KeyCode.One,   ["2"] = Enum.KeyCode.Two,
    ["3"] = Enum.KeyCode.Three, ["4"] = Enum.KeyCode.Four,
    ["5"] = Enum.KeyCode.Five,  ["6"] = Enum.KeyCode.Six,
    ["7"] = Enum.KeyCode.Seven, ["8"] = Enum.KeyCode.Eight,
    ["9"] = Enum.KeyCode.Nine,  ["0"] = Enum.KeyCode.Zero,
}

local function CharToKeyInfo(ch)
    if SHIFT_MAP[ch] then
        return SHIFT_MAP[ch], true
    elseif NUM_MAP[ch] then
        return NUM_MAP[ch], false
    elseif ch:match("%u") then
        return Enum.KeyCode[ch], true
    elseif ch:match("%l") then
        return Enum.KeyCode[ch:upper()], false
    end
    return nil, false
end

local function TransposeChar(ch, semitones)
    local idx = CHAR_TO_INDEX[ch]
    if not idx then return ch end
    local newIdx = math.clamp(idx + semitones, 1, #SCALE_CHARS)
    return INDEX_TO_CHAR[newIdx]
end

local function ParseSheet(rawSheet)
    local events = {}
    local errors = {}

    if type(rawSheet) ~= "string" or rawSheet:match("^%s*$") then
        return events, {"Sheet is empty."}
    end

    local i, len, noteCount = 1, #rawSheet, 0
    while i <= len do
        local ch = rawSheet:sub(i, i)

        if ch == "[" then
            local closePos = rawSheet:find("]", i + 1, true)
            if not closePos then
                table.insert(errors, "Unclosed '[' bracket at position " .. i)
                break
            end
            local inside = rawSheet:sub(i + 1, closePos - 1)
            local chord = {}
            for j = 1, #inside do
                local c = inside:sub(j, j)
                if CHAR_TO_INDEX[c] then
                    table.insert(chord, c)
                    noteCount += 1
                elseif not c:match("%s") then
                    table.insert(errors, "Invalid note '" .. c .. "' inside [...]")
                end
            end
            if #chord > 0 then
                table.insert(events, { notes = chord, beats = 1.0 })
            end
            i = closePos + 1

        elseif ch == "{" then
            local closePos = rawSheet:find("}", i + 1, true)
            if not closePos then
                table.insert(errors, "Unclosed '{' brace at position " .. i)
                break
            end
            local inside = rawSheet:sub(i + 1, closePos - 1)
            local arp = {}
            for j = 1, #inside do
                local c = inside:sub(j, j)
                if CHAR_TO_INDEX[c] then
                    table.insert(arp, c)
                    noteCount += 1
                end
            end
            local step = (#arp > 0) and (1.0 / #arp) or 0.25
            for _, n in ipairs(arp) do
                table.insert(events, { notes = { n }, beats = step })
            end
            i = closePos + 1

        elseif CHAR_TO_INDEX[ch] then
            table.insert(events, { notes = { ch }, beats = 1.0 })
            noteCount += 1
            i += 1

        elseif ch == " " then
            if #events > 0 then events[#events].beats += 0.45 end
            i += 1

        elseif ch == "-" or ch == "|" then
            if #events > 0 then events[#events].beats += 0.85 end
            i += 1

        elseif ch == "\n" or ch == "\r" or ch == "/" then
            if #events > 0 then events[#events].beats += 1.0 end
            i += 1

        else
            i += 1
        end
    end

    if noteCount == 0 then
        table.insert(errors, "No valid piano notes found.")
    end

    return events, errors
end

local function EstimateSeconds(events, bpm)
    local beats = 0
    for _, ev in ipairs(events) do
        beats += ev.beats
    end
    return beats * (60 / math.max(bpm, 20))
end

local function FormatClock(sec)
    sec = math.max(0, math.floor(sec + 0.5))
    return string.format("%d:%02d", math.floor(sec / 60), sec % 60)
end

local function TriggerNote(char, transposeOffset)
    local actual = TransposeChar(char, transposeOffset)
    local idx = CHAR_TO_INDEX[actual]
    if not idx then return end

    if VirtualInputManager then
        local kc, needsShift = CharToKeyInfo(actual)
        if kc then
            pcall(function()
                if needsShift then
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)
                end
                VirtualInputManager:SendKeyEvent(true, kc, false, game)
                task.delay(0.045, function()
                    pcall(function()
                        VirtualInputManager:SendKeyEvent(false, kc, false, game)
                        if needsShift then
                            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
                        end
                    end)
                end)
            end)
        end
    end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("RemoteEvent") and (obj.Name == "PlayNote" or obj.Name == "NotePressed" or obj.Name == "KeyPressed") then
            pcall(function()
                obj:FireServer(IndexToNoteName(idx))
            end)
            break
        end
    end
end

